// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "NorasApp",

	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:resolute",

	// Network hardening: allows iptables rules in the container (internet yes, local network no)
	"runArgs": ["--cap-add=NET_ADMIN"],

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// Node.js (via nvm) + npm + pnpm
		"ghcr.io/devcontainers/features/node:2": {
			"version": "lts"
		},
		// Zsh, Git, jq, curl, wget, ripgrep, ... and a passwordless-sudo user
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"configureZshAsDefaultShell": true,
			"upgradePackages": true,
			"username": "automatic",
			"sudoers": true
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [5173],
	"portsAttributes": {
		"5173": {
			"label": "Vite dev server"
		}
	},

	// Persist Cline sessions per project across rebuilds. Each project
	// automatically gets its own volume based on the folder name, so chats
	// stay in this project only.
	"mounts": [
		"source=cline-history-${localWorkspaceFolderBasename},target=/home/vscode/.cline,type=volume"
	],

	// Install dependencies after the container is created.
	"postCreateCommand": "npm install",

	// Network hardening: allow internet, block local network/LAN (runs on every start)
	"postStartCommand": "bash -c 'sudo iptables -N CLINE_NETGUARD 2>/dev/null; sudo iptables -F CLINE_NETGUARD; sudo iptables -C OUTPUT -j CLINE_NETGUARD 2>/dev/null || sudo iptables -I OUTPUT 1 -j CLINE_NETGUARD; sudo iptables -A CLINE_NETGUARD -o lo -j ACCEPT; sudo iptables -A CLINE_NETGUARD -p udp --dport 53 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -p tcp --dport 53 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -d 172.17.0.0/16 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -d 192.168.1.144/32 -p tcp --dport 3000 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -d 192.168.1.144/32 -p tcp --dport 22 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -d 192.168.0.0/16 -j REJECT; sudo iptables -A CLINE_NETGUARD -d 10.0.0.0/8 -j REJECT; sudo iptables -A CLINE_NETGUARD -d 172.16.0.0/12 -j REJECT'",

	// ---------------------------------------------------------------------------
	// Connecting to a local folder
	// ---------------------------------------------------------------------------
	// By default the folder you opened in VS Code is already mounted. In this
	// environment /workspaces/ubuntu is a Docker volume, though (see README.md).
	//
	// If you want a real bind mount of your local folder instead, uncomment the
	// following two lines:
	//
	// "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/projekt,type=bind,consistency=cached",
	// "workspaceFolder": "/workspaces/projekt"

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"saoudrizwan.claude-dev" // Cline (AI agent)
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh"
			}
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}